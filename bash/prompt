# Prompt appearance.

# left
PS1='\[\e[1;36m\]\w\[\e[0m\] ❯ '
# right
RPS1='\[\e[2m\]\A\[\e[0m\]'
# command 실행 후에는 간결하게
PS1_FINAL='\[\e[2m\]❯\[\e[0m\] '
RPS1_FINAL=''
PS1_FILL_FINAL=''
# prompt 사이 구분선 없이 깔끔하게
PROMPT_RULER=''

if [[ -n ${YAZI_SUBSHELL-} ]]; then
  yazi_prompt_badge='\[\e[1;30;43m\] YAZI subshell (exit to return) \[\e[0m\] '
  PS1="$yazi_prompt_badge$PS1"
  PS1_FINAL="$yazi_prompt_badge$PS1_FINAL"
  unset yazi_prompt_badge
fi

# Remote host and container badges live on the left prompt.
prompt_badges=''

if [[ -n ${SSH_CONNECTION-}${SSH_CLIENT-}${SSH_TTY-} ]]; then
  prompt_badges+="\\[\\e[1;33m\\]${SSH_PROMPT_HOST:-\\h}\\[\\e[0m\\] "
fi

container_name=''
if [[ -e /run/.containerenv || -e /.dockerenv || -e /run/systemd/container || -n ${container-} ]]; then
  container_name=${CONTAINER_ID-}   # distrobox names its container here
  if [[ -z $container_name && -r /run/.containerenv ]]; then
    container_name=$(sed -n 's/^name="\([^"]*\)"$/\1/p' /run/.containerenv)
  fi
  container_name=${container_name:-${HOSTNAME:-$(hostname)}}
  prompt_badges+="\\[\\e[1;30;45m\\] $container_name \\[\\e[0m\\] "
fi

if [[ -n $prompt_badges ]]; then
  PS1="$prompt_badges$PS1"
  PS1_FINAL="$prompt_badges$PS1_FINAL"
fi
unset prompt_badges container_name
