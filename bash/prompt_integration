# Flyline - enhanced Bash experience
# enable flyline 2>/dev/null || enable -f "$HOME/.local/lib/libflyline.so" flyline
if [[ $- == *i* && -r $HOME/.local/lib/libflyline.so ]]; then
  enable -f "$HOME/.local/lib/libflyline.so" flyline
  flyline key bind Ctrl+r 'always=runBashCommand(__atuin_widget_run)+submitOrNewline'
fi

