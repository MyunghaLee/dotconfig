# Shared interactive Bash configuration.

export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Homebrew (system-wide first, then the per-user fallback).
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x $HOME/.homebrew/bin/brew ]]; then
  eval "$("$HOME/.homebrew/bin/brew" shellenv)"
fi

# Atuin's installer places its PATH setup here instead of in .bashrc.
if [[ -r $HOME/.atuin/bin/env ]]; then
  source -- "$HOME/.atuin/bin/env"
fi

# Keep Codex configuration and local state under the XDG data directory.
export CODEX_HOME="$XDG_DATA_HOME/codex"

# User executables, TeX Live, and mise-managed tools.
case :$PATH: in
  *:"$HOME/.local/bin":*) ;;
  *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
esac

texlive_bin="$XDG_DATA_HOME/texlive/2026/bin/x86_64-linux"
case :$PATH: in
  *:"$texlive_bin":*) ;;
  *) export PATH="$texlive_bin${PATH:+:$PATH}" ;;
esac
unset texlive_bin

# opencode
opencode_bin="$HOME/.opencode/bin"
case :$PATH: in
  *:"$opencode_bin":*) ;;
  *) export PATH="$opencode_bin${PATH:+:$PATH}" ;;
esac
unset opencode_bin

if [[ -x $HOME/.local/bin/mise ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi

# Pick the first editor available on this machine.
for bash_editor_candidate in nvim vim vi nano; do
  if bash_editor_path=$(command -v "$bash_editor_candidate" 2>/dev/null); then
    export EDITOR=$bash_editor_path
    export SUDO_EDITOR=$bash_editor_path
    break
  fi
done
unset bash_editor_candidate bash_editor_path

export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"
unset SSH_ASKPASS GIT_ASKPASS

# Load ble.sh from the XDG data directory after PATH is ready, but attach only
# after all integrations.
bash_data_home="$XDG_DATA_HOME"
if [[ $- == *i* && -r $bash_data_home/blesh/ble.sh ]]; then
  source -- "$bash_data_home/blesh/ble.sh" --attach=none
fi
unset bash_data_home

# Shell integrations.
if command -v glow >/dev/null 2>&1; then
  source <(glow completion bash)
fi

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init bash --disable-up-arrow)"
fi

if command -v carapace >/dev/null 2>&1; then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  export CARAPACE_MATCH=1
  source <(carapace _carapace)
fi

# Fish-style convenience functions.
alias pd='pandoc --defaults="${XDG_CONFIG_HOME:-$HOME/.config}/pandoc/config.yaml"'

unalias ls ll lt man vi vim 2>/dev/null

ls() {
  if command -v eza >/dev/null 2>&1; then
    command eza --icons --git --color=always "$@"
  else
    command ls --color=auto "$@"
  fi
}

ll() {
  if command -v eza >/dev/null 2>&1; then
    command eza -lah --icons --git "$@"
  else
    command ls --color=auto -l "$@"
  fi
}

lt() {
  if command -v eza >/dev/null 2>&1; then
    command eza --tree --icons --level=2 "$@"
  else
    command tree -L 2 "$@"
  fi
}

man() {
  if command -v vim >/dev/null 2>&1; then
    MANPAGER='vim -M +MANPAGER -' command man "$@"
  else
    command man "$@"
  fi
}

if [[ -n ${EDITOR-} ]]; then
  vi()  { command "$EDITOR" "$@"; }
  vim() { command "$EDITOR" "$@"; }
fi

cf()    { command yazi "${XDG_CONFIG_HOME:-$HOME/.config}" "$@"; }
rc()    { command "$EDITOR" "${XDG_CONFIG_HOME:-$HOME/.config}/bash/config" "$@"; }
rcal()  { command yazi "${XDG_CONFIG_HOME:-$HOME/.config}/bash" "$@"; }
sc()    { exec bash; }
sshcf() { command "$EDITOR" "${XDG_CONFIG_HOME:-$HOME/.config}/ssh/config" "$@"; }
tocu()  { command "$EDITOR" "${XDG_CONFIG_HOME:-$HOME/.config}/touchcursor/touchcursor.conf" "$@"; }

oc()     { OPENCODE_ENABLE_EXA=true command opencode "$@"; }
rb()     { command sudo reboot now "$@"; }
rbtocu() { command systemctl --user restart touchcursor "$@"; }
rbtw()   { command sudo grub2-reboot 4 && command sudo reboot now "$@"; }
dbrb()   { command pkill -f dropbox; sleep 1; command dropbox start "$@"; }

sshy() {
  command ssh "$@" -t "bash -l -c 'fish -l -c y'"
}

zj() {
  if (($#)); then
    command zellij attach --create "$@"
  else
    command zellij attach --create dev
  fi
}

y() {
  local yazi_tmp yazi_cwd yazi_status
  yazi_tmp=$(mktemp -t yazi-cwd.XXXXXX) || return
  command yazi "$@" --cwd-file="$yazi_tmp"
  yazi_status=$?

  if yazi_cwd=$(command cat -- "$yazi_tmp") &&
     [[ -n $yazi_cwd && $yazi_cwd != "$PWD" ]]; then
    builtin cd -- "$yazi_cwd" || yazi_status=$?
  fi

  command rm -f -- "$yazi_tmp"
  return "$yazi_status"
}

# Count commands across sessions and sync Atuin every 100 commands.
if [[ ${BLE_VERSION-} ]] && command -v atuin >/dev/null 2>&1; then
  bash_atuin_sync_counter_file="${XDG_CACHE_HOME:-$HOME/.cache}/atuin_sync_counter"

  _bash_atuin_sync_on_100() {
    local counter_file=$bash_atuin_sync_counter_file
    local counter_dir=${counter_file%/*}
    local current_count=0

    command mkdir -p -- "$counter_dir"
    {
      command flock -x 9
      [[ -r $counter_file ]] && IFS= read -r current_count < "$counter_file"
      [[ $current_count =~ ^[0-9]+$ ]] || current_count=0

      if ((++current_count >= 100)); then
        printf '0\n' > "$counter_file"
        printf '\e[33m󱍢 Reached 100 commands across all sessions. Syncing...\e[0m\n'
        if command atuin sync; then
          printf '\e[32m✔ Sync completed!\e[0m\n'
        fi
      else
        printf '%d\n' "$current_count" > "$counter_file"
      fi
    } 9>"$counter_file.lock"
  }

  blehook POSTEXEC!='_bash_atuin_sync_on_100'
fi

# Machine-local overrides are intentionally not tracked with shared config.
bash_local_config="${XDG_CONFIG_HOME:-$HOME/.config}/bash/local_config"
if [[ -r $bash_local_config ]]; then
  source -- "$bash_local_config"
fi
unset bash_local_config

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach
