# Shared interactive Bash configuration.

bash_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bash"
source -- "$bash_config_dir/environment"
source -- "$bash_config_dir/integrations"
source -- "$bash_config_dir/aliases"
source -- "$bash_config_dir/functions"

# Machine-local overrides are intentionally not tracked with shared config.
if [[ -r $bash_config_dir/local_config ]]; then
  source -- "$bash_config_dir/local_config"
fi

source -- "$bash_config_dir/prompt_integration"
source -- "$bash_config_dir/prompt"
unset bash_config_dir
