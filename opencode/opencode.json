{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate" : false,
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 1050000,
            "input": 250000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
  "mcp": {
    "servers": {
      "deckcraft": {
        "type": "local",
        "command": [
          "deckcraft-cli",
          "mcp",
          "--connect",
          "127.0.0.1:7990"
        ]
      },
      "vectorcraft": {
        "type": "local",
        "command": [
          "vectorcraft-cli",
          "mcp",
          "--connect",
          "127.0.0.1:7993"
        ]
      },
      "gridcraft": {
        "type": "local",
        "command": [
          "gridcraft-cli",
          "mcp",
          "--connect",
          "127.0.0.1:7991"
        ]
      },
      "pdfcraft": {
        "type": "local",
        "command": [
          "pdfcraft-cli",
          "mcp"
        ]
      },
      "wordcraft": {
        "type": "local",
        "command": [
          "wordcraft-cli",
          "mcp",
          "--connect",
          "127.0.0.1:7992"
        ]
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ]
}
