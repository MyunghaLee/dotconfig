{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "session.first": "ctrl+g,alt+home,shift+pageup",
    "session.last": "ctrl+alt+g,shift+pagedown",
    "session.line.up": "ctrl+k,ctrl+alt+y",
    "session.line.down": "ctrl+j,ctrl+alt+e",
    "session.page.up": "pageup,ctrl+alt+b,ctrl+u",
    "session.page.down": "pagedown,ctrl+alt+f,ctrl+d",
    "app.exit": "ctrl+c,<leader>q",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.delete": "delete,shift+delete",
    "input.delete.to.line.end": "none",
    "input.delete.to.line.start": "none",
    "session.delete": "none",
    "queued_prompt.delete": "none",
    "queued_prompt.undo": "none",
    "stash.delete": "none",
    "model.dialog.usage": "none",
    "dialog.integration.delete": "none",
    "dialog.move_session.delete": "none",
    "dialog.plugins.update": "none",
    "composer.subagent.interrupt": "none",
    "composer.shell.kill": "none",
    "diff.half_page.down": "none",
    "diff.half_page.up": "none",
    "input.visual.line.home": "alt+a,home",
    "input.visual.line.end": "alt+e,end"
  },
  "animations": true
}
